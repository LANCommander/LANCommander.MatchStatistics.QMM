# Build trees (one per CMake preset), game sources fetched for the checks, packages
out/
build/
package/

# vcpkg manifest-mode installs land under the build tree, but an IDE may put them here
vcpkg_installed/

# Local overrides, e.g. LANCOMMANDER_INTERPOSER_DIR pointing at a working copy
CMakeUserPresets.json

# Python
__pycache__/

# IDE
.vs/
.vscode/
.idea/
